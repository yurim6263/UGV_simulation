# ── 환경 변수 / 비밀 정보 ────────────────────────────────
.env
*.env
!*.env.example

# ── Python 캐시 / 가상환경 ───────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/

# ── 빌드 / 배포 산출물 ───────────────────────────────────
dist/
build/
*.egg-info/
.eggs/

# ── 테스트 / 커버리지 ─────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── 로그 ─────────────────────────────────────────────────
*.log
logs/

# ── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── 임시/로컬 패치 스크립트 (루트에 남은 잔여물) ─────────────
/auth_integration_patch.py
/auth_router.py
/load_grid.py
/load_weather.py
/seed_scenarios.py
/backend/auth_integration_patch.py
/backend/auth_router.py
/backend/load_grid.py
/backend/load_weather.py
/backend/seed_scenarios.py

# 최적화 중간 저장 (재현용 임시 파일)
backend/data/optimization/*.stage1.json

# 개발용 SQLite 파일
*.db
*.db-journal

# ERA5 지역 강수 캐시 (스크립트가 다시 만든다)
backend/data/weather/cache/

# 시나리오 날짜의 ERA5 원시 기상(직접 내려받는 파일, scripts/download_era5_scenario.py)
backend/data/weather/*.nc

# OSM 도로 원자료(Overpass 에서 다시 받는다, app/geo/static_grid.py)
backend/data/osm/
